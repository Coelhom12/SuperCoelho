# Copie para .env (nunca versione o .env) e troque todos os valores.
DB_USER=escalas
DB_PASSWORD=troque-esta-senha
# Gere com: openssl rand -base64 48
APP_JWT_SECRET=
# Senha do usuário "gestor" criado no primeiro start (vazio = gerada e exibida no log).
# Use uma senha forte: 8+ caracteres com maiúscula, minúscula, número e caractere especial.
APP_ADMIN_SENHA=
# true = carrega o cenário de demonstração quando o banco está vazio.
APP_SEED=true
GRAFANA_SENHA=troque-esta-senha
# Opcional: servidor TURN para chamadas de voz em redes restritas (ex.: turn:turn.seudominio.com:3478).
APP_TURN_URLS=
APP_TURN_SEGREDO=
